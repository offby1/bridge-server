    {
      "type": "timeseries",
      "title": "Rate-limit rejections per second (429s)",
      "description": "Requests Caddy shed. This does NOT break down by zone: the caddy-ratelimit plugin's per-zone metrics exist only on its unreleased master branch, and xcaddy builds the latest tag (v0.1.0), which has none. For the zone of each rejection use `just caddy-log`, which reads the log line the plugin does emit. See docs/perf/crowdsec-plan.md, Phase 4.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{code=\"429\"}[5m])) or vector(0)",
          "legendFormat": "429 rate-limited",
          "range": true,
          "refId": "A"
        }
      ]
    },
