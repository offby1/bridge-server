    {
      "type": "timeseries",
      "title": "Scenario overflows per hour",
      "description": "An overflow is a scenario concluding somebody is misbehaving. offby1/caddy-per-ip-ratelimit is ours; the crowdsecurity/* ones are hub scenarios reading the access log.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "short"
