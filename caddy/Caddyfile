# caddy-docker-proxy merges this base Caddyfile with the docker-label config, via
# CADDY_DOCKER_CADDYFILE_PATH. It supplies the things the labels cannot express
# cleanly:
#
#   1. the global `order` directives that tell Caddy where the two third-party
#      handlers, rate_limit and crowdsec, run in the chain;
#   2. the global `crowdsec` app block, which configures the connection to the
#      CrowdSec local API;
#   3. the metrics listener on :2020; and
#   4. two reusable snippets, (crowdsec) and (ratelimit), applied to the site by
#      `caddy.import_0` and `caddy.import_1` labels on the django service.
#
# For the reasoning and the failures these guard against, see
# docs/perf/crawler-repro.md and docs/perf/crowdsec-plan.md.

{
    # The order of these two matters, and it is the whole point of stating it.
    # A banned IP must be refused *before* it touches a rate-limit bucket:
    # otherwise a banned flood still eats the shared `list_views` and
    # `whole_site` budgets on its way to being rejected, which is precisely the
    # harm those aggregate zones exist to prevent.
    order crowdsec before rate_limit
    order rate_limit before reverse_proxy

    # How Caddy reaches CrowdSec's local API in order to ask whether an address
    # is banned.
    #
    # `crowdsec` is the compose service name, resolved on the compose network,
    # and 8080 is CrowdSec's local API port. The key comes from the environment
    # rather than being written here; docker-compose-caddy.yaml passes it in and
    # the justfile reads it from a file outside the repo.
    #
    # We leave two options at their defaults, deliberately:
    #
    #   * Streaming mode stays on, so the plugin pulls the decision list every
    #     `ticker_interval` and answers from memory. A request therefore costs no
    #     round trip to CrowdSec. Setting `disable_streaming` would make every
    #     request wait on a query.
    #
    #     Streaming has one known hazard in our particular combination. With
    #     caddy-docker-proxy, a graceful reload can leave the admin API hung on
    #     "shutting down admin server: context deadline exceeded"
    #     (hslatman/caddy-crowdsec-bouncer#61). We mitigate it by raising
    #     CADDY_DOCKER_EVENT_THROTTLE_INTERVAL to 5s in
    #     docker-compose-caddy.yaml, which is what the plugin's own startup
    #     warning asks for. If reload hangs show up anyway, the documented
    #     workaround is `disable_streaming`, which trades a per-request query for
    #     reliable reloads.
    #
    #   * `enable_hard_fails` stays off, so Caddy still starts when CrowdSec is
    #     unreachable. Turning it on would mean a CrowdSec problem takes the
    #     entire site down, which is a far worse failure than briefly not
    #     enforcing bans.
    crowdsec {
        api_url http://crowdsec:8080
        api_key {$CROWDSEC_API_KEY}
        ticker_interval 60s

        # Export the bouncer's own counters through the /metrics listener below.
        # Measured on beta, this gives exactly two of them,
        # crowdsec_bouncer_lapi_requests_total and
        # crowdsec_bouncer_lapi_requests_failures_total, both labelled by mode.
        # They are a health signal -- whether Caddy is successfully talking to
        # the local API -- and NOT a count of blocked requests, which the plugin
        # does not report. For blocks, count 403s in
        # caddy_http_request_duration_seconds_count.
        enable_caddy_metrics
    }

    # This option makes Caddy collect per-request HTTP metrics, the caddy_http_*
    # family, which is off by default. Without it, /metrics still carries Go
    # runtime counters but no request counts, durations or status codes. The
    # status codes are the part we actually wanted, because they are how we count
    # 429s.
    #
    # We use the global option rather than the `servers { metrics }` form,
    # because Caddy warns that the nested one is deprecated and will be removed
    # in the next major version.
    #
    # Note that this does NOT get us the rate limiter's own per-zone counters.
    # The caddy-ratelimit plugin has only one tag, v0.1.0, which contains no
    # metrics code at all; those counters live on its unreleased master branch,
    # and xcaddy builds the latest tag. See docs/perf/crowdsec-plan.md, Phase 4.
    metrics
}

# This is the Prometheus scrape target. It is deliberately a separate listener on
# a port that docker-compose-caddy.yaml does NOT publish, so that it is reachable
# from the compose network, where Prometheus lives, and from nowhere else.
#
# The obvious alternative would be to point Prometheus at Caddy's admin endpoint,
# which also serves /metrics, but that would mean binding the admin API to
# something other than localhost. Since that API can rewrite Caddy's whole
# configuration, exposing it to every container on the network merely to obtain
# some counters would be a bad trade. This listener serves metrics and nothing
# else.
#
# There is no hostname here, so Caddy attempts no automatic HTTPS and has no
# certificate to fail to obtain. See docs/perf/crowdsec-plan.md, Phase 4.
:2020 {
    metrics /metrics
}

# This snippet asks CrowdSec whether the client is banned, and refuses the
# request if so. The django service applies it with a `caddy.import_0: crowdsec`
# label.
#
# There is deliberately nothing to configure here. Which addresses are banned is
# CrowdSec's business, decided by the scenarios in crowdsec/scenarios/ and by the
# hub collections named in docker-compose-crowdsec.yaml. This is only the
# enforcement point.
#
# Note what installing this did on the day it first deployed: every unexpired
# decision already in CrowdSec's database became a live ban at once, because
# those decisions had been accumulating since Phase 2 with nothing to act on
# them. Check `just cscli decisions list` before a deploy that adds this, not
# after.
(crowdsec) {
    crowdsec
}

# Three complementary limits, all shedding at the edge (HTTP 429 + Retry-After)
# before a request reaches Daphne or opens a Postgres connection. A request must
# pass every applicable zone; the tightest one wins. Thresholds were measured on
# beta (cpx21, same as prod) with an `ab` concurrency ramp; real legit traffic
# peaks at ~3.5 req/s (busiest minute in two weeks), so all three sit far above
# legit and below where Daphne collapses. See docs/perf/crawler-repro.md.
#
#   * per_ip     -- any single client IP. `key {remote_host}` is the real client
#                   IP (Caddy terminates TLS at the edge). 50/10s ~= 5 req/s.
#                   Defeats a single-IP flood (the 2026-07-15 crawler) and keeps
#                   one IP from eating the shared budgets below.
#   * list_views -- AGGREGATE across ALL IPs for the expensive, crawlable
#                   endpoints (list views + tournament pages incl. the slow RSS
#                   feed). `key static` = one shared bucket. 20/s ~= half their
#                   measured ~40 req/s ceiling. Defeats a *distributed* botnet
#                   crawl of these paths (the 2026-08-04 outage: ~24k IPs, <=4
#                   requests each -- every IP under the per-IP limit, yet the
#                   total still buried Daphne).
#   * whole_site -- AGGREGATE across ALL IPs and ALL paths: the catch-all
#                   backstop for a flood that pivots to some other endpoint.
#                   45/s ~= half the ~90 req/s ceiling of even a cheap request
#                   (every request pays the full middleware stack under the GIL,
#                   so the whole app caps near there).
(ratelimit) {
    rate_limit {
        zone per_ip {
            key    {remote_host}
            events 50
            window 10s
        }
        zone list_views {
            match {
                path /players/* /board/* /hand/* /tournament*
            }
            key    static
            events 20
            window 1s
        }
        zone whole_site {
            key    static
            events 45
            window 1s
        }
    }
}
